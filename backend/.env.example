APP_NAME=Sensei
APP_VERSION=0.1.0
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:5173"]

# MongoDB
MONGO_DB=
MONGO_DB_NAME=sensei

# Auth (JWT_SECRET: openssl rand -hex 32)
JWT_SECRET=
# Encrypts stored source credentials. openssl rand -hex 32
# Losing this makes existing sources unreadable — they must be reconnected.
SECRET_ENCRYPTION_KEY=
JWT_EXPIRE_DAYS=7
GOOGLE_CLIENT_ID=

# Agent / Vector store
GROQ_API_KEY=
# Tried in order when a model's daily quota is exhausted (each Groq model has its own).
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,qwen/qwen3.6-27b,openai/gpt-oss-20b
# Free hosted fallbacks — any of these keys joins the chain behind Groq.
CEREBRAS_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Granted MCP tools offered per question, only those the question touches (a server like GitHub lists ~50).
MAX_GRANT_TOOLS_PER_TURN=8
CHROMA_PERSIST_DIR=./chroma_data

# AWS / Bedrock AgentCore
# Set LLM_BACKEND=bedrock and provide AWS credentials for AgentCore
# Set LLM_BACKEND=groq to use Groq locally without AWS credentials
LLM_BACKEND=groq
AWS_REGION=us-east-1
# Cross-region inference profiles. Needs an IAM user or role — AWS refuses Bedrock calls from the account root.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_BACKGROUND_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# AWS credentials — use either keys or IAM role (preferred for production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Phase 2: S3 session storage (required when LLM_BACKEND=bedrock)
S3_SESSION_BUCKET=

# Phase 3: Bedrock Knowledge Bases (optional — for uploaded file indexing via AWS)
# Setup: create a KB in AWS console (OpenSearch Serverless, Titan Embeddings v2, S3 data source)
S3_UPLOAD_BUCKET=
BEDROCK_KB_ID=
BEDROCK_KB_DATA_SOURCE_ID=

# Frontend (used for invite URL generation)
FRONTEND_ORIGIN=http://localhost:5173
